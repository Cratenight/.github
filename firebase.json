{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "README.md",
      "node_modules/**",
      "bench/**",
      "package.json",
      "package-lock.json",
      "vitest.config.js",
      ".gitignore"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
